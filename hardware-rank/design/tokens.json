{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "CPU.News 设计令牌——Web / App 共用的唯一真相。由 scripts/gen-tokens.mjs 生成 src/tokens.css；未来 App 端（RN / Swift / Kotlin）直接读本文件生成各自平台常量。颜色统一用 RGB 三元组字符串，便于 alpha 叠加。",
  "meta": { "name": "CPU.News Precision", "version": "2.0.0" },

  "font": {
    "sans": { "$type": "fontFamily", "$value": ["Inter", "Noto Sans SC", "Noto Sans JP", "PingFang SC", "Hiragino Sans", "Microsoft YaHei", "system-ui", "sans-serif"] },
    "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "SF Mono", "Menlo", "Consolas", "monospace"] },
    "features": { "$type": "string", "$value": "\"cv11\", \"ss01\", \"ss03\", \"tnum\"" }
  },

  "type": {
    "$description": "字号 / 行高 / 字距；display 用于首页大标题，label 用于单行 UI 文本，mono-* 用于数据。",
    "display": { "size": 56, "line": 1.02, "tracking": -0.035, "weight": 650 },
    "h1": { "size": 32, "line": 1.1, "tracking": -0.025, "weight": 650 },
    "h2": { "size": 20, "line": 1.25, "tracking": -0.015, "weight": 600 },
    "h3": { "size": 16, "line": 1.35, "tracking": -0.01, "weight": 600 },
    "body": { "size": 14, "line": 1.55, "tracking": 0, "weight": 400 },
    "label": { "size": 13, "line": 1.3, "tracking": 0, "weight": 500 },
    "caption": { "size": 12, "line": 1.4, "tracking": 0, "weight": 400 },
    "overline": { "size": 11, "line": 1.2, "tracking": 0.08, "weight": 600 },
    "mono-data": { "size": 13, "line": 1.2, "tracking": -0.01, "weight": 500 },
    "mono-stat": { "size": 28, "line": 1.05, "tracking": -0.03, "weight": 600 }
  },

  "radius": {
    "$description": "Geist 式阶梯：控件 6 / 卡片 10 / 面板 14 / 全屏 18。",
    "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 18, "full": 9999
  },

  "space": { "$description": "4pt 基线", "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64 },

  "motion": {
    "fast": { "duration": 120, "easing": "cubic-bezier(.2,.7,.2,1)" },
    "base": { "duration": 180, "easing": "cubic-bezier(.2,.7,.2,1)" },
    "slow": { "duration": 280, "easing": "cubic-bezier(.2,.7,.2,1)" }
  },

  "layout": { "sidebar": 240, "content": 1800, "gutter": { "mobile": 16, "desktop": 40 }, "touch": 44 },

  "brand": {
    "$description": "厂商色——两种模式共用。",
    "amd": "#ED1C24", "nvidia": "#76B900", "intel": "#0068B5", "apple": "#1D1D1F", "qualcomm": "#3253DC",
    "gold": { "light": "#B7791F", "dark": "#F2C94C" },
    "silver": { "light": "#64748B", "dark": "#C4CCD6" },
    "bronze": { "light": "#9A5B2B", "dark": "#D9915B" }
  },

  "color": {
    "$description": "角色命名（Radix 1-12 思路）：bg 页面 / surface 卡片 / surface-2 次级 / surface-3 悬停 / line 分隔 / line-2 交互边框 / fg 主文 / muted 次文 / faint 弱文 / accent 主色 / accent-fg 主色上的文字 / inverse 反色按钮。",
    "light": {
      "bg": "250 250 251",
      "surface": "255 255 255",
      "surface-2": "247 247 249",
      "surface-3": "240 241 244",
      "line": "232 233 237",
      "line-2": "214 216 222",
      "line-3": "180 184 194",
      "fg": "17 17 19",
      "muted": "98 102 112",
      "faint": "140 144 154",
      "accent": "37 99 235",
      "accent-2": "59 130 246",
      "accent-fg": "255 255 255",
      "inverse": "17 17 19",
      "inverse-fg": "255 255 255",
      "success": "22 163 74",
      "warn": "202 138 4",
      "danger": "220 38 38"
    },
    "dark": {
      "bg": "9 9 11",
      "surface": "17 17 20",
      "surface-2": "24 24 28",
      "surface-3": "32 32 37",
      "line": "38 38 44",
      "line-2": "54 54 62",
      "line-3": "82 82 92",
      "fg": "237 237 240",
      "muted": "150 153 163",
      "faint": "108 111 122",
      "accent": "96 142 255",
      "accent-2": "130 168 255",
      "accent-fg": "9 9 11",
      "inverse": "237 237 240",
      "inverse-fg": "9 9 11",
      "success": "74 222 128",
      "warn": "250 204 21",
      "danger": "248 113 113"
    }
  },

  "shadow": {
    "$description": "亮色用两层投影；暗色几乎不用投影，改用 1px 内高光（--ring-hi）表达层级。",
    "light": {
      "sm": "0 1px 1px rgb(17 17 19 / .04), 0 1px 2px rgb(17 17 19 / .04)",
      "md": "0 1px 2px rgb(17 17 19 / .04), 0 8px 24px -12px rgb(17 17 19 / .12)",
      "lg": "0 2px 4px rgb(17 17 19 / .04), 0 24px 48px -16px rgb(17 17 19 / .18)",
      "ring-hi": "inset 0 1px 0 rgb(255 255 255 / .6)"
    },
    "dark": {
      "sm": "0 0 0 1px rgb(255 255 255 / .04)",
      "md": "0 1px 2px rgb(0 0 0 / .5), 0 12px 32px -16px rgb(0 0 0 / .7)",
      "lg": "0 2px 6px rgb(0 0 0 / .6), 0 32px 64px -24px rgb(0 0 0 / .8)",
      "ring-hi": "inset 0 1px 0 rgb(255 255 255 / .06)"
    }
  }
}
